<Window x:Class="HuaCi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="划词翻译 - 设置"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,6,20,16">
        <!-- DeepSeek -->
        <TextBlock Style="{StaticResource Section}" Text="DeepSeek 接口"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Label}" Text="API Key"/>
            <Grid Grid.Column="1">
                <PasswordBox x:Name="ApiKeyBox" Height="28"/>
                <TextBox x:Name="ApiKeyPlainBox" Height="28" Visibility="Collapsed"/>
            </Grid>
            <CheckBox x:Name="ShowKeyCheck" Grid.Column="2" Content="显示" Margin="8,0,0,0" VerticalAlignment="Center"
                      Checked="ShowKeyCheck_Changed" Unchecked="ShowKeyCheck_Changed"/>

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Base URL"/>
            <TextBox x:Name="BaseUrlBox" Grid.Row="2" Grid.Column="1" Height="28"/>
            <Button Grid.Row="2" Grid.Column="2" Content="默认" MinWidth="0" Margin="8,0,0,0" Padding="8,2"
                    Click="ResetBaseUrl_Click"/>

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="模型"/>
            <ComboBox x:Name="ModelBox" Grid.Row="4" Grid.Column="1" IsEditable="True" Height="28">
                <ComboBoxItem Content="deepseek-chat"/>
                <ComboBoxItem Content="deepseek-reasoner"/>
            </ComboBox>
            <Button x:Name="TestButton" Grid.Row="4" Grid.Column="2" Content="测试" MinWidth="0" Margin="8,0,0,0"
                    Padding="8,2" Click="TestButton_Click"/>

            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" Visibility="Collapsed"/>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap">
                    还没有 Key？前往
                    <Hyperlink NavigateUri="https://platform.deepseek.com/api_keys" RequestNavigate="Hyperlink_RequestNavigate">DeepSeek 开放平台</Hyperlink>
                    创建。Key 使用 Windows DPAPI 加密保存，仅当前用户可解密。
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 翻译 -->
        <TextBlock Style="{StaticResource Section}" Text="翻译"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="中文译为"/>
            <ComboBox x:Name="TargetZhBox" Grid.Column="1" IsEditable="True" Height="28"/>
            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="其他语言译为"/>
            <ComboBox x:Name="TargetOtherBox" Grid.Row="2" Grid.Column="1" IsEditable="True" Height="28"/>
        </Grid>

        <!-- 快捷键 -->
        <TextBlock Style="{StaticResource Section}" Text="快捷键"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="翻译选中文字"/>
            <TextBox x:Name="HotkeyBox" Grid.Column="1" Height="28" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"
                     LostKeyboardFocus="HotkeyBox_LostFocus" InputMethod.IsInputMethodEnabled="False"
                     ToolTip="点击后直接按下新的组合键，例如 Ctrl+Alt+D"/>
            <Button Grid.Column="2" Content="默认" MinWidth="0" Margin="8,0,0,0" Padding="8,2" Click="ResetHotkey_Click"/>
        </Grid>
        <TextBlock x:Name="HotkeyHint" Margin="90,4,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                   Text="点击输入框后按下新的组合键（需包含 Ctrl / Alt / Shift / Win 之一）"/>

        <!-- 常规 -->
        <TextBlock Style="{StaticResource Section}" Text="常规"/>
        <CheckBox x:Name="AutoStartCheck" Content="开机时自动启动"/>
        <CheckBox x:Name="SelectIconCheck" Content="划词后在鼠标旁显示翻译图标（拖动选择或双击选词后出现，点击即翻译）"/>
        <CheckBox x:Name="ExpandSourceCheck" Content="弹窗中默认展开原文"/>

        <!-- 按钮 -->
        <Grid Margin="0,18,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12">
                <Hyperlink Click="OpenFolder_Click">打开配置文件夹</Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" IsDefault="True" Click="SaveButton_Click"/>
                <Button Content="取消" IsCancel="True" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
